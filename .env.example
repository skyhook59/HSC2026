# HSC SuperContest Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application Configuration (OPTIONAL)
# Base path for URL generation (e.g., '/HSC-test' for subdirectory deployment)
# Leave empty for root deployment (production)
APP_BASE_PATH=

# Database Configuration (REQUIRED)
DB_HOST=hscdb.db
DB_NAME=supercontest2025
DB_USER=skyhook
DB_PASS=your_database_password_here

# Session Configuration (OPTIONAL)
# Leave empty to use current domain
SESSION_DOMAIN=

# Email Configuration (REQUIRED for pick confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=HSC Picks

# API Authentication (OPTIONAL)
# Secret key for protected API endpoints
FEED_SECRET=your_random_secret_key_here

# Application Environment (OPTIONAL)
# APP_ENV=production
# APP_DEBUG=false
